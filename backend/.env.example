# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=4000

# SQLite local por defecto; producción requiere PostgreSQL.
# SQLite local por defecto; producción requiere PostgreSQL.
DATABASE_URL=sqlite:./data/traza.sqlite
# true para proveedores administrados que exigen SSL (Render, Neon, Supabase)
DATABASE_SSL=false

# Secreto para firmar las sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Orígenes del frontend autorizados (separados por coma). En producción, con https.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Imágenes (carpeta del backend; en producción usa un disco persistente o almacenamiento de objetos)
UPLOAD_DIR=./subidas
MAX_IMAGE_BYTES=5242880

# Servicio de rutas compatible con OSRM. El servidor público es solo para demostraciones:
# para producción usa un OSRM propio o un proveedor con contrato.
OSRM_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=12000

# Mapa base (respeta la política de uso de los tiles de OpenStreetMap)
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Origen por defecto de las rutas (se puede cambiar luego desde Configuración)
ORIGEN_LAT=6.2455
ORIGEN_LON=-75.5707
