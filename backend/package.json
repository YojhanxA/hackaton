{
  "name": "traza-educativa-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API de Traza Educativa Medellín: instituciones, imágenes, reintegros, informes, rutas y bitácora certificada.",
  "type": "commonjs",
  "main": "src/servidor.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/servidor.js",
    "start": "node src/servidor.js",
    "migrar": "node src/db/migrar.js",
    "crear-usuario": "node scripts/crear-usuario.js",
    "seed:instituciones": "node scripts/seed-instituciones.js",
