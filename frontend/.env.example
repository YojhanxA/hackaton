# Copia como .env.local (desarrollo) o configúralas en Vercel/Netlify. Son PÚBLICAS: no pongas secretos aquí.

# URL del backend. Déjala VACÍA: el frontend llama a /api en su mismo dominio.
# - En desarrollo, Vite redirige /api a http://127.0.0.1:4000.
# - En Vercel, frontend/vercel.json reenvía /api al backend de Render. Así el navegador no habla
#   con onrender.com (que bloquean algunas redes corporativas) y no hay CORS.
VITE_API_URL=

# Blockchain para anclar la bitácora (por defecto Polygon Amoy, red de prueba)
VITE_CONTRATO=
# VITE_CHAIN_ID=80002
# VITE_CHAIN_NOMBRE=Polygon Amoy
# VITE_CHAIN_RPC=https://rpc-amoy.polygon.technology
# VITE_CHAIN_EXPLORADOR=https://amoy.polygonscan.com
# VITE_CHAIN_MONEDA=POL
